# ============================================================
# LEADYFY OS - Environment Configuration Example
# ============================================================

# Database Connection URL
# Local SQLite default:
DATABASE_URL="file:./dev.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/leadyfy_os?schema=public"

# Session & JWT secret
AUTH_SECRET="your-super-secret-key-at-least-32-chars-long"

# Environment
NODE_ENV="development"
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Storage Configuration
# Options: "local" (uses /public/uploads) or "s3"
STORAGE_PROVIDER="local"
AWS_S3_BUCKET="your-bucket-name"
AWS_ACCESS_KEY_ID="your-access-key-id"
AWS_SECRET_ACCESS_KEY="your-secret-access-key"
AWS_REGION="us-east-1"
