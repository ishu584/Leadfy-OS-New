# Database URL - SQLite for zero-dependency local development, PostgreSQL ready
DATABASE_URL="file:./dev.db"

# Authentication secret for session signatures
AUTH_SECRET="leadyfy-os-super-secret-jwt-key-development-2026"

# Environment
NODE_ENV="development"
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cloud Storage (Optional - fallback to local storage /public/uploads when not configured)
STORAGE_PROVIDER="local"
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
